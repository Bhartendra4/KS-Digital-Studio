# ============================================================
#  KS DIGITAL STUDIO — Environment configuration
#  Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://ksdigitalstudio.in

# --- CRM admin login (REQUIRED for the dashboard) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# Long random string used to sign admin sessions (REQUIRED in production):
SESSION_SECRET=generate-a-long-random-string-here

# --- CRM data location (optional; defaults to ~/.ksds-crm) ---
# CRM_DATA_DIR=C:\\Users\\you\\.ksds-crm

# --- AI features (OPTIONAL): add ONE provider key to enable real AI drafting ---
# Get from https://console.anthropic.com  OR  https://platform.openai.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Without a key, outreach/proposals use built-in personalised templates and the
# assistant uses built-in deterministic answers — everything still works.

# --- Lead notifications (OPTIONAL) ---
# Email via Resend (https://resend.com):
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@ksdigitalstudio.in
LEAD_NOTIFY_FROM=KS Digital Studio <onboarding@resend.dev>
# WhatsApp notification webhook (optional, e.g. your own relay / Twilio bridge):
WHATSAPP_NOTIFY_WEBHOOK=

# --- Contact form (existing) ---
# NEXT_PUBLIC_WEB3FORMS_KEY=
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_CLARITY_ID=
